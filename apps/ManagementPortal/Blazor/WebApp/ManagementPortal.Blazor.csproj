<Project Sdk="Microsoft.NET.Sdk.Web">

	<Import Project="$(BuildPropsDirectory)/common.service.props" />

	<PropertyGroup>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
		<PreserveCompilationReferences>true</PreserveCompilationReferences>
		<RootNamespace>FinanceServices.ManagementPortal.Blazor</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ByteLabs.Aps.Hosting.Blazor" />
		<PackageReference Include="ByteLabs.Foundations.IdentityModel.HttpClient.Web" />
		<PackageReference Include="ByteLabs.Foundations.AspNetCore.Components.FluentDesignUI.Blazor" />
		<PackageReference Include="ByteLabs.Foundations.AspNetCore.Mvc.Client" />
		<PackageReference Include="ByteLabs.Foundations.Http.Client.Web" />
		<PackageReference Include="ByteLabs.PlatformServices.Account.Public.HttpApi.Client" />
		<PackageReference Include="ByteLabs.PlatformServices.Account.Web.Impersonation" />
		<PackageReference Include="ByteLabs.PlatformServices.Security.IdentityServer.Blazor.Server" />
	</ItemGroup>


	<ItemGroup>
		<None Update="Pages\**\*.js">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Pages\**\*.css">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	
	<ItemGroup>
	  <ProjectReference Include="..\..\..\..\services\Administration\src\Blazor.Server\AdministrationService.Blazor.Server.csproj" />
	  <ProjectReference Include="..\..\..\..\services\Identity\src\Blazor.Server\IdentityService.Blazor.Server.csproj" />
	  <ProjectReference Include="..\..\..\..\services\Identity\src\HttpApi.Client\IdentityService.HttpApi.Client.csproj" />
	  <ProjectReference Include="..\..\..\..\services\FinanceServices\src\Blazor.Server\FinanceServicesService.Blazor.Server.csproj" />
	  <ProjectReference Include="..\..\..\..\services\Saas\src\Blazor.Server\SaasService.Blazor.Server.csproj" />
	  <ProjectReference Include="..\..\..\..\services\Saas\src\HttpApi.Client\SaasService.HttpApi.Client.csproj" />
	  <ProjectReference Include="..\..\..\..\shared\Shared.Hosting.AspNetCore\Shared.Hosting.AspNetCore.csproj" />
	  <ProjectReference Include="..\..\..\..\shared\Shared.Localization\Shared.Localization.csproj" />
	  <ProjectReference Include="..\..\..\..\shared\Shared.Settings\Shared.Settings.csproj" />
	  <ProjectReference Include="..\WebApp.Client\ManagementPortal.Blazor.Client.csproj" />
	</ItemGroup>

</Project>

@page
@using System.Globalization;
@using ByteLabs.FinanceServices.Localization.Localization
@using ByteLabs.Foundations.AspNetCore.Mvc.UI.Layout
@using ByteLabs.Foundations.AspNetCore.UI.Widgets
@using ByteLabs.PlatformServices.AuditLogging.Web.Pages.Shared.Components
@using ByteLabs.PlatformServices.SaaS.Web.Pages.Shared.Components.SaasEditionPercentageWidget
@using ByteLabs.PlatformServices.SaaS.Web.Pages.Shared.Components.SaasLatestTenantsWidget
@using Microsoft.AspNetCore.Mvc.Localization;
@using Microsoft.AspNetCore.Mvc.Rendering;
@using FinanceServices.ManagementPortal.Web.Navigation
@using FinanceServices.ManagementPortal.Web.Pages
@inject IHtmlLocalizer<FinanceServicesResource> L
@inject IWidgetManager WidgetManager
@model  HostDashboardModel
@inject IPageLayout PageLayout
@{
    ViewBag.PageTitle = "Dashboard";
    PageLayout.Content.Title = L["Dashboard"].Value;
    PageLayout.Content.MenuItemName = FinanceServicesMenus.HostDashboard;
}

@section scripts {
    <abp-script-bundle name="@typeof(HostDashboardModel).FullName">
        <abp-script src="/Pages/HostDashboard.js" />
    </abp-script-bundle>
}

@section styles {
    <abp-style-bundle name="@typeof(HostDashboardModel).FullName">
        <abp-style src="/Pages/HostDashboard.css" />
    </abp-style-bundle>
}

<abp-card>
    <abp-card-body>
        <form method="get" id="DashboardFilterForm">
            <abp-row h-align="Center" v-align="Center" id="datepicker" class="input-daterange">
                <div class="mb-3 col-12 col-lg-5 col-md-6 mb-lg-0">
                    <div class="mb-0 form-group">
                        <div class="input-group">
                            <label class="input-group-text">@L["StartDate"].Value</label>
                            <input type="text"
                                   class="form-control"
                                   name="StartDate"
                                   value="@DateTime.Now.AddMonths(-1).Date.ToString(CultureInfo.CurrentUICulture.DateTimeFormat.ShortDatePattern)" />
                        </div>
                    </div>
                </div>
                <div class="mb-3 col-12 col-lg-5 col-md-6 mb-lg-0">
                    <div class="mb-0 form-group">
                        <div class="input-group">
                            <label class="input-group-text">@L["EndDate"].Value</label>
                            <input type="text"
                                   class="form-control"
                                   name="EndDate"
                                   value="@DateTime.Now.Date.ToString(CultureInfo.CurrentUICulture.DateTimeFormat.ShortDatePattern)" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-2 col-md-12">
                    <abp-button button-type="Primary" icon="refresh" class="btn-block" type="Submit" text="@L["Refresh"].Value" />
                </div>
            </abp-row>
        </form>
    </abp-card-body>
</abp-card>
<div id="HostDashboardWidgetsArea" data-widget-filter="#DashboardFilterForm">
    <abp-row>
         @if (await WidgetManager.IsGrantedAsync(typeof(AuditLoggingErrorRateWidgetViewComponent)))
        {
            <abp-column size-md="_12" size-lg="_6">
                @await Component.InvokeAsync(typeof(AuditLoggingErrorRateWidgetViewComponent))
            </abp-column>
        }
        @if (await WidgetManager.IsGrantedAsync(typeof(AuditLoggingAverageExecutionDurationPerDayWidgetViewComponent)))
        {
            <abp-column size-md="_12" size-lg="_6">
                @await Component.InvokeAsync(typeof(AuditLoggingAverageExecutionDurationPerDayWidgetViewComponent))
            </abp-column>
        }
        @if (await WidgetManager.IsGrantedAsync(typeof(SaasEditionPercentageWidgetViewComponent)))
        {
            <abp-column size-md="_12" size-lg="_6">
                @await Component.InvokeAsync(typeof(SaasEditionPercentageWidgetViewComponent))
            </abp-column>
        }
        @if (await WidgetManager.IsGrantedAsync(typeof(SaasLatestTenantsWidgetViewComponent)))
        {
            <abp-column size-md="_12" size-lg="_6">
                @await Component.InvokeAsync(typeof(SaasLatestTenantsWidgetViewComponent))
            </abp-column>
        }
    </abp-row>
</div>
